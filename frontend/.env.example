# Base URL of the API. Leave empty in development (Vite proxies /api to the backend)
# and when the backend serves the built frontend from the same origin.
VITE_API_URL=
# Public origin used for share links (defaults to the current browser origin).
VITE_PUBLIC_APP_URL=
# Where the Vite dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:5050
