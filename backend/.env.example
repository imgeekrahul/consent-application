# ---- Server ----
PORT=5050
NODE_ENV=development
# Public URL of the web app, used to build share links (no trailing slash).
# Leave empty to use the host of the incoming request.
PUBLIC_APP_URL=http://localhost:5173
# Set to 1 (or a subnet) when running behind a reverse proxy so client IPs and rate limits are correct.
TRUST_PROXY=
# Comma-separated list, only needed when the frontend is served from a different origin.
CORS_ORIGINS=
# Serve the built frontend (../frontend/dist) from this server (single-origin production deploy).
SERVE_FRONTEND=false

# ---- Admin authentication ----
ADMIN_USERNAME=admin
# Recommended: generate with `npm run hash-password -- "your password"`
ADMIN_PASSWORD_HASH=
# Alternative for local development only (plain text):
ADMIN_PASSWORD=ChangeMe-Local-Dev-123
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---- Database ----
# Leave empty to use the built-in JSON file store (data/documents.json).
# MONGODB_URI=mongodb://127.0.0.1:27017/consent-app
MONGODB_URI=

# ---- Storage & limits ----
UPLOADS_DIR=uploads
SIGNED_DIR=signed-documents
DATA_DIR=data
MAX_UPLOAD_MB=20
MAX_SIGNATURE_KB=2048
MAX_PAGES=500
